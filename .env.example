# ========================================================
# SWEETER APPLICATION CONFIGURATION TEMPLATE
# Salin file ini menjadi .env dan sesuaikan nilainya.
# JANGAN PERNAH MENYIMPAN KREDENSIAL ASLI DI FILE INI.
# ========================================================

# Secret Key untuk Penandatanganan JWT (HS256)
# WAJIB minimal 32 byte (256-bit) untuk standar keamanan RFC 7518
# Contoh pembuatan secret key acak yang aman via Python:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti_dengan_secret_key_acak_minimal_32_byte_disini

# MongoDB Connection String (URI Koneksi MongoDB Atlas atau Lokal)
MONGODB_CONNECTION_STRING=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Nama Database MongoDB
MONGODB_DATABASE=dbsparta_plus_week4

# Environment Mode: development / production
APP_ENV=development

